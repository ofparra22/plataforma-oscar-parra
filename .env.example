# Copia este archivo como .env.local (web) y no lo subas al repo.

# Configuración pública de Firebase (la da la consola de Firebase al registrar la app web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Número de WhatsApp de Oscar para los enlaces wa.me (solo dígitos, con lada de país)
VITE_WHATSAPP_OSCAR=

# Functions: "mock" usa datos de prueba; "real" usa la API de Meta
META_MODO=mock

# El token de Meta NO va aquí. Se guarda con:
#   firebase functions:secrets:set META_SYSTEM_USER_TOKEN
